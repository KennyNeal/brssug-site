---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';

type Props = {
  meeting: CollectionEntry<'meetings'>;
  speakerPicture?: string;
};

const { meeting, speakerPicture } = Astro.props;
const { title, date, speaker, youtubeUrl } = meeting.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<li class="meeting-list-item">
  <span class="meeting-list-date">{formatDate(date)}</span>
  <span class="meeting-list-title"><a href={`${base}/meetings/${meeting.id}/`}>{title}</a></span>
  {speaker !== 'TBD' && (
    <span class="meeting-list-speaker-group">
      <span class="meeting-list-speaker">{speaker}</span>
      {speakerPicture
        ? <img src={speakerPicture} alt={speaker} class="meeting-list-photo" width="28" height="28" />
        : <div class="meeting-list-photo meeting-list-photo-initial" aria-hidden="true">{speaker.slice(0, 1)}</div>
      }
    </span>
  )}
  {youtubeUrl && (
    <a class="meeting-list-link" href={youtubeUrl} target="_blank" rel="noreferrer">Watch →</a>
  )}
</li>
